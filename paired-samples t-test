.live{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-top:14px}
.live div{border:1.5px dashed var(--line);border-radius:8px;padding:6px 10px}
.live small{display:block;color:var(--dim);font-size:12px}
.live span{font-family:var(--hand);font-size:1.6rem;font-weight:700}
#verdict{margin-top:12px;font-family:var(--hand);font-size:1.35rem;font-weight:700}
table.script{min-width:620px}
.script td,.script th{white-space:normal;text-align:left!important;vertical-align:top}
.script td:nth-child(1){white-space:nowrap;color:var(--yel);font-family:var(--hand);font-size:1.1rem}
.script td:nth-child(2){color:var(--dim);width:24%}
ul{margin:0;padding-left:1.2em}li{margin:4px 0}
html[data-m="easy"] .pro{display:none}
html[data-m="pro"] .easy{display:none}
.foot{color:var(--dim);font-size:12px}
.board:fullscreen{overflow:auto}
</style>
</head>
<body>

<div class="wrap">
  <div class="top">
    <h1>대응표본 t검정 칠판 수업
      <small class="easy">같은 곳을 두 번 재서 “전·후” 변화가 진짜인지 확인하는 방법</small>
      <small class="pro">Paired samples t-test: 짝지어진 관측의 차이 d에 대한 검정</small></h1>
    <div class="seg" role="group" aria-label="설명 수준"><button id="mEasy" aria-pressed="true">쉬운 설명</button><button id="mPro" aria-pressed="false">전공 설명</button></div>
  </div>

  <div>
    <div class="board" id="board">
      <canvas id="cv" aria-label="대응표본 t검정 칠판 애니메이션"></canvas>
      <div id="subs" style="display:none"></div>
    </div>
    <div class="tray" style="margin-top:0">
      <div class="row">
        <button class="btn" id="play">일시정지</button>
        <button class="btn ghost" id="restart">처음부터</button>
        <select id="speed" aria-label="재생 속도"><option value="0.5">0.5배</option><option value="1" selected>1배</option><option value="2">2배</option></select>
        <input type="range" id="seek" min="0" max="1000" value="0" aria-label="재생 위치">
      </div>
      <div class="row">
        <button class="btn ghost" id="vBtn">음성 켜기</button>
        <select id="vSel" aria-label="목소리"></select>
        <select id="rate" aria-label="말하기 속도"><option value="0.85">천천히</option><option value="1" selected>보통 속도</option><option value="1.15">빠르게</option></select>
        <button class="btn ghost" id="fs">전체화면</button>
        <span id="vNote"></span>
      </div>
      <div class="chips" id="chips"></div>
    </div>
  </div>

  <div class="note" id="cap"></div>

  <section class="card">
    <h2>결과표 <span class="pro" style="font-size:1rem;color:var(--dim)">(JAMOVI 대응표본 T-검정 형식)</span></h2>
    <div class="tbl"><table>
      <thead><tr><th></th>
        <th><span class="easy">점수(t)</span><span class="pro">통계량</span></th><th>df</th>
        <th><span class="easy">우연일 확률</span><span class="pro">p</span></th>
        <th><span class="easy">평균 변화</span><span class="pro">평균 차이</span></th><th><span class="easy">흔들림 1칸</span><span class="pro">SE 차이</span></th>
        <th><span class="easy">변화의 범위(95%)</span><span class="pro">95% 신뢰구간</span></th>
        <th><span class="easy">변화의 크기</span><span class="pro">Cohen's d</span></th></tr></thead>
      <tbody><tr><td>개통 후 − 개통 전</td><td class="num" id="r_t"></td><td class="num" id="r_df"></td><td class="num" id="r_p"></td><td class="num" id="r_md"></td><td class="num" id="r_se"></td><td class="num" id="r_ci"></td><td class="num" id="r_d"></td></tr></tbody>
    </table></div>
    <p class="muted easy">JAMOVI에 “개통 전, 개통 후” 순서로 넣으면 “전 − 후”로 계산해서 t와 평균 차이에 마이너스(−)가 붙어요. 크기와 우연일 확률은 똑같아요.</p>
    <p class="muted pro" id="report"></p>
  </section>

  <section class="card">
    <h2>직접 바꿔보기</h2>
    <div class="sliders">
      <label><span><span class="easy">평균 변화 (신호)</span><span class="pro">평균 차이 d̄</span> : <b id="vM"></b>백만 원</span><input type="range" id="sM" min="-4" max="8" step="0.1" value="3"></label>
      <label><span><span class="easy">상권마다 변화의 들쭉날쭉</span><span class="pro">차이의 표준편차 s_d</span> : <b id="vS"></b>백만 원</span><input type="range" id="sS" min="1" max="8" step="0.1" value="3.6"></label>
      <label><span><span class="easy">조사한 상권 수</span><span class="pro">쌍의 수 n</span> : <b id="vN"></b>곳</span><input type="range" id="sN" min="5" max="30" step="1" value="10"></label>
    </div>
    <div style="margin-top:12px"><button class="btn ghost" id="resample">새 표본 뽑기</button></div>
    <div class="live">
      <div><small><span class="easy">평균 변화(신호)</span><span class="pro">d̄</span></small><span id="lD"></span></div>
      <div><small><span class="easy">변화의 흔들림 1칸</span><span class="pro">SE = s_d/√n</span></small><span id="lSe"></span></div>
      <div><small><span class="easy">점수 t (몇 칸?)</span><span class="pro">t</span></small><span id="lT"></span></div>
      <div><small><span class="easy">우연일 확률</span><span class="pro">p (양측)</span></small><span id="lP"></span></div>
    </div>
    <div id="verdict"></div>
  </section>

  <section class="card">
    <div class="top" style="align-items:center"><h2 style="margin:0">영상 시나리오(대본)</h2><button class="btn ghost" id="copyScript">대본 복사</button></div>
    <p class="muted">직접 설명하실 때는 장면 버튼을 누르고 애니메이션이 끝나면 일시정지한 뒤 대본을 읽으세요. 음성 켜기를 누르면 브라우저가 대본을 읽어 줍니다.</p>
    <div class="tbl"><table class="script"><thead><tr><th>장면</th><th>화면</th><th>내레이션</th></tr></thead><tbody id="scriptBody"></tbody></table></div>
  </section>

  <section class="card">
    <h2><span class="easy">쓰기 전에 확인할 것</span><span class="pro">가정과 점검</span></h2>
    <ul class="easy">
      <li>같은 상권(같은 점포, 같은 집)을 <b>두 번</b> 잰 자료여야 해요. 서로 다른 상권끼리 비교하면 독립표본 t검정을 써요.</li>
      <li>전·후 짝이 정확히 맞아야 해요. 한쪽만 있는 상권은 빼요.</li>
      <li>짝을 지으면 상권마다 원래 다른 매출 수준이 지워져서, 같은 변화도 더 잘 보여요.</li>
      <li>전·후 사이에 다른 일(경기 변화, 계절)이 있었다면, 변화가 모두 지하철 때문이라고 말할 수 없어요.</li>
    </ul>
    <ul class="pro">
      <li>대응표본 t검정 = 차이 dᵢ = 후 − 전에 대한 일표본 t검정(μ₀ = 0). df = n − 1.</li>
      <li>정규성은 원자료가 아니라 <b>차이 d</b>에 대해 확인(Shapiro-Wilk, Q-Q). 위반 시 Wilcoxon 부호순위 검정.</li>
      <li>부호 뒤집기(sign-flip) 순열 검정: H₀ 하에서 각 쌍의 전·후 이름표가 교환 가능.</li>
      <li>전후 비교의 인과 해석은 시간 효과와 혼동됨. 대조 상권을 둔 이중차분(DID)이 더 강한 설계.</li>
    </ul>
  </section>

  <p class="foot">예시 데이터는 설명을 위해 만든 가상의 수치이며 실제 매출이 아닙니다. 단위: 점포당 월평균 매출(백만 원).</p>
</div>

<script>
(()=>{
// ---------- 통계 ----------
function lgamma(x){const c=[0.99999999999980993,676.5203681218851,-1259.1392167224028,771.32342877765313,-176.61502916214059,12.507343278686905,-0.13857109526572012,9.9843695780195716e-6,1.5056327351493116e-7];
  if(x<0.5)return Math.log(Math.PI/Math.sin(Math.PI*x))-lgamma(1-x);x-=1;let a=c[0];const t=x+7.5;for(let i=1;i<9;i++)a+=c[i]/(x+i);return 0.5*Math.log(2*Math.PI)+(x+0.5)*Math.log(t)-t+Math.log(a);}
function betacf(x,a,b){let qab=a+b,qap=a+1,qam=a-1,c=1,d=1-qab*x/qap;if(Math.abs(d)<1e-30)d=1e-30;d=1/d;let h=d;
  for(let m=1;m<=200;m++){const m2=2*m;let aa=m*(b-m)*x/((qam+m2)*(a+m2));d=1+aa*d;if(Math.abs(d)<1e-30)d=1e-30;c=1+aa/c;if(Math.abs(c)<1e-30)c=1e-30;d=1/d;h*=d*c;
  aa=-(a+m)*(qab+m)*x/((a+m2)*(qap+m2));d=1+aa*d;if(Math.abs(d)<1e-30)d=1e-30;c=1+aa/c;if(Math.abs(c)<1e-30)c=1e-30;d=1/d;const del=d*c;h*=del;if(Math.abs(del-1)<3e-12)break;}return h;}
function ibeta(x,a,b){if(x<=0)return 0;if(x>=1)return 1;const bt=Math.exp(lgamma(a+b)-lgamma(a)-lgamma(b)+a*Math.log(x)+b*Math.log(1-x));return x<(a+1)/(a+b+2)?bt*betacf(x,a,b)/a:1-bt*betacf(1-x,b,a)/b;}
const pT2=(t,df)=>ibeta(df/(df+t*t),df/2,0.5);
const tpdf=(x,df)=>Math.exp(lgamma((df+1)/2)-lgamma(df/2))/Math.sqrt(df*Math.PI)*Math.pow(1+x*x/df,-(df+1)/2);
function tcrit(df){let lo=0,hi=30;for(let i=0;i<60;i++){const m=(lo+hi)/2;pT2(m,df)>0.05?lo=m:hi=m;}return (lo+hi)/2;}
function rng(seed){return()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
const gauss=r=>Math.sqrt(-2*Math.log(r()+1e-12))*Math.cos(2*Math.PI*r());
const mean=a=>a.reduce((x,y)=>x+y,0)/a.length;
const sdv=a=>{const m=mean(a);return Math.sqrt(a.reduce((x,y)=>x+(y-m)**2,0)/(a.length-1));};
const f1=v=>v.toFixed(1),f2=v=>v.toFixed(2);
const fp=p=>p<0.001?'< .001':p.toFixed(3).replace(/^0/,'');
const pct=p=>p<0.001?'0.1% 미만':(p*100).toFixed(1)+'%';
const spPct=p=>p<0.001?'0.1퍼센트 미만':(p*100).toFixed(1)+'퍼센트';

// ---------- 데이터 ----------
const SIMS=300,BW=0.25;let seed=4,P={m:3,s:3.6,n:10},D;
function build(){
  const n=P.n,r=rng(seed*131+n),std=z=>{const m=mean(z),s=sdv(z);return z.map(v=>(v-m)/s);};
  const zb=[],zd=[];for(let i=0;i<n;i++){zb.push(gauss(r));zd.push(gauss(r));}
  const B=std(zb).map(v=>Math.round((42+8*v)*10)/10),dd0=std(zd).map(v=>Math.round((P.m+P.s*v)*10)/10),A=B.map((b,i)=>Math.round((b+dd0[i])*10)/10);
  const d=A.map((a,i)=>Math.round((a-B[i])*10)/10),md=mean(d),sd=sdv(d),se=sd/Math.sqrt(n),df=n-1,t=md/se,p=pT2(Math.abs(t),df),tc=tcrit(df);
  const r2=rng(seed*7919+n*29),sims=[],flips=[];
  for(let k=0;k<SIMS;k++){const sg=d.map(()=>r2()<0.5?-1:1);if(k<3)flips.push(sg);const x=d.map((v,i)=>v*sg[i]),s2=sdv(x);sims.push(s2>0?mean(x)/(s2/Math.sqrt(n)):0);}
  const bins={},pile=sims.map(v=>{const b=Math.max(-20,Math.min(20,Math.round(v/BW)));bins[b]=(bins[b]||0)+1;return{v,b,h:bins[b]-1};});
  const maxC=Math.max(...Object.values(bins)),ext=sims.filter(v=>Math.abs(v)>=Math.abs(t)).length;
  const all=A.concat(B),lo=Math.floor((Math.min(...all)-2)/5)*5,hi=Math.ceil((Math.max(...all)+2)/5)*5;
  const dm=Math.max(4,Math.ceil(Math.max(...d.map(Math.abs))+1));
  D={A,B,d,md,sd,se,df,t,p,tc,dz:md/sd,ci:[md-tc*se,md+tc*se],pile,flips,maxC,ext,lo,hi,dm,mB:mean(B),mA:mean(A)};
  panels();if(starts.length){layout();script();}
}

// ---------- 모드 ----------
let mode='easy';const L=(e,p)=>mode==='easy'?e:p;
function setMode(m){mode=m;document.documentElement.dataset.m=m;
  document.getElementById('mEasy').setAttribute('aria-pressed',m==='easy');document.getElementById('mPro').setAttribute('aria-pressed',m==='pro');
  stopSpeech();chips();panels();layout();script();}
document.getElementById('mEasy').onclick=()=>setMode('easy');document.getElementById('mPro').onclick=()=>setMode('pro');

// ---------- 장면 ----------
const up=()=>D.md>=0?'늘었':'줄었';
const ST=[
 {d:3,e:'궁금한 질문',p:'가설 세우기',scr:'칠판에 “개통 전 / 개통 후” 두 줄 이름표',
  ce:()=>`“지하철역이 생기면 상권 매출이 오를까?” 같은 상권을 <b>개통 전과 개통 후에 두 번</b> 재서 비교해요. 이럴 때 쓰는 것이 <b>대응표본 t검정</b>이에요.`,
  cp:()=>`H₀: μ_d = 0, H₁: μ_d ≠ 0 (양측). 동일 단위의 반복측정, 차이 d = 후 − 전.`,
  ne:()=>`지하철역이 새로 생기면 주변 상권 매출이 정말 오를까요? 같은 상권을 개통 전과 개통 후에 두 번 재서 비교해 볼게요. 이럴 때 쓰는 방법이 대응표본 티 검정이에요.`,
  np:()=>`대응표본 티 검정은 같은 대상을 두 번 측정한 짝지어진 자료를 비교합니다. 귀무가설은 개통 후와 개통 전 매출 차이의 모평균이 0이라는 것입니다.`},
 {d:4,e:'같은 곳 두 번 재기',p:'짝지은 자료',scr:'위 줄(개통 전)과 아래 줄(개통 후)에 점이 찍히고, 같은 상권끼리 선으로 이어짐',
  ce:()=>`<b>${P.n}개 상권</b>의 점포당 월평균 매출을 개통 전(위)과 후(아래)에 찍고, <b>같은 상권끼리 선</b>으로 이었어요. 선이 오른쪽으로 기울면 매출이 늘어난 곳이에요.`,
  cp:()=>`n = ${P.n}쌍. 전 x̄ = ${f2(D.mB)}, 후 x̄ = ${f2(D.mA)}. 두 측정은 독립이 아님(같은 상권).`,
  ne:()=>`${P.n}개 상권의 점포당 월평균 매출을 개통 전과 개통 후에 찍고, 같은 상권끼리 선으로 이었어요. 선이 오른쪽으로 기울면 매출이 늘어난 상권이에요. 상권마다 원래 매출 수준이 꽤 다르죠.`,
  np:()=>`${P.n}개 상권의 개통 전후 매출을 짝지어 나타냈습니다. 같은 상권의 두 측정값은 서로 독립이 아니므로, 상권 간 수준 차이를 제거하고 차이만 분석합니다.`},
 {d:4,e:'차이만 남기기',p:'차이 점수',scr:'선들이 “차이 점”으로 줄어들어 차이 0선 주변에 모이고, 평균 변화 화살표',
  ce:()=>`상권마다 원래 매출 수준은 다르니까 <b>“얼마나 변했나”만</b> 남겨요. 선 하나가 점 하나(후 − 전)가 돼요. 평균 변화는 <b>${f1(D.md)}백만 원</b>, 이것이 “신호”예요.`,
  cp:()=>`dᵢ = 후ᵢ − 전ᵢ. d̄ = ${f2(D.md)}. 이제 문제는 d에 대한 일표본 t검정(μ₀ = 0)과 같음.`,
  ne:()=>`상권마다 원래 매출 수준이 다르니까, 얼마나 변했는지만 남길게요. 선 하나가 점 하나가 돼요. 개통 후에서 개통 전을 뺀 값이에요. 평균 변화는 ${f1(D.md)}백만 원, 이것이 신호예요.`,
  np:()=>`각 쌍의 차이를 계산하면 평균 차이는 ${f2(D.md)}백만 원입니다. 이제 이 문제는 차이 점수에 대해 기준값 0과 비교하는 일표본 티 검정과 같습니다.`},
 {d:4,e:'변화의 흔들림',p:'표준오차',scr:'차이 점의 넓은 띠가 좁은 괄호로 줄어듦',
  ce:()=>`상권마다 변화도 들쭉날쭉해요(±${f1(D.sd)}백만 원). 하지만 ${P.n}곳의 <b>평균 변화</b>는 덜 흔들려요. √${P.n}로 나눈 <b>${f2(D.se)}백만 원</b>이 흔들림 “1칸”이에요.`,
  cp:()=>`s_d = ${f2(D.sd)}, SE = s_d/√n = ${f2(D.se)}.`,
  ne:()=>`상권마다 변화의 크기도 들쭉날쭉해요. 하지만 ${P.n}곳의 평균 변화는 그보다 덜 흔들려요. 들쭉날쭉을 상권 수의 제곱근으로 나눈 ${f2(D.se)}백만 원이 흔들림 한 칸이에요.`,
  np:()=>`차이의 표준편차는 ${f2(D.sd)}이고, 평균 차이의 표준오차는 이를 n의 제곱근으로 나눈 ${f2(D.se)}입니다.`},
 {d:4,e:'몇 칸 떨어졌나',p:'t 통계량',scr:'“변화 0”에서 시작하는 흔들림 눈금자, 평균 변화가 몇 칸째인지 표시',
  ce:()=>`“변화 0”에서 출발해 흔들림 1칸으로 재요. ${f1(Math.abs(D.md))} ÷ ${f2(D.se)} = <b>${f2(Math.abs(D.t))}칸</b>. 이 칸 수가 <b>t값</b>이에요.`,
  cp:()=>`t = d̄/SE = ${f2(D.md)}/${f2(D.se)} = ${f2(D.t)}, df = n − 1 = ${D.df}.`,
  ne:()=>`변화 0에서 출발해서 흔들림 한 칸으로 재 볼게요. ${f1(Math.abs(D.md))}을 ${f2(D.se)}로 나누면 ${f2(Math.abs(D.t))}칸이에요. 이 칸 수가 티 값이에요.`,
  np:()=>`티 통계량은 평균 차이를 표준오차로 나눈 ${f2(D.t)}이며, 자유도는 쌍의 수에서 1을 뺀 ${D.df}입니다.`},
 {d:6,e:'전·후 뒤집기 300번',p:'부호 뒤집기 분포',scr:'차이 점들이 0을 기준으로 좌우로 뒤집히고, 아래 칠판에 점수 300개가 쌓임',
  ce:()=>`지하철이 아무 영향이 없다면 “전”과 “후”를 바꿔 불러도 상관없겠죠. 그러면 변화의 방향(+/−)이 뒤집혀요. 상권마다 동전을 던져 <b>전·후를 300번</b> 뒤집어 점수를 쟀더니, 우리 점수보다 먼 경우는 <b>300번 중 ${D.ext}번(${(D.ext/3).toFixed(1)}%)</b>이에요.`,
  cp:()=>`H₀ 하에서 각 쌍의 전·후 이름표는 교환 가능 → dᵢ의 부호를 무작위로 뒤집은 ${SIMS}회 분포. |t*| ≥ ${f2(Math.abs(D.t))}: ${D.ext}/${SIMS} = ${(D.ext/SIMS).toFixed(3)}.`,
  ne:()=>`만약 지하철이 아무 영향이 없다면, 개통 전과 개통 후를 바꿔 불러도 상관없겠죠. 그러면 변화의 방향이 뒤집혀요. 상권마다 동전을 던져서 전과 후를 바꾸는 일을 300번 해 봤어요. 우리 점수 ${f2(Math.abs(D.t))}보다 멀리 나온 경우는 300번 중 ${D.ext}번이에요.`,
  np:()=>`귀무가설이 참이면 각 쌍의 전후 이름표는 서로 바꿀 수 있습니다. 차이의 부호를 무작위로 뒤집어 300번 티 값을 계산한 분포에서, 관측값보다 극단적인 경우는 ${D.ext}번입니다. 이 비율이 부호 뒤집기 순열 검정의 피 값입니다.`},
 {d:4,e:'판정',p:'결론',scr:'더미 위에 t분포 곡선이 겹치고 판정 도장',
  ce:()=>D.p<0.05?`곡선으로 정확히 계산한 우연일 확률은 <b>${pct(D.p)}</b>. 5%보다 작으니 “개통 후 매출이 <b>${up()}다</b>”고 판단해요.`:`곡선으로 계산한 우연일 확률은 <b>${pct(D.p)}</b>. 5% 이상이라 “매출이 변했다고 <b>말하기 어렵다</b>”고 판단해요.`,
  cp:()=>`t(${D.df}) 분포의 양측 p = ${fp(D.p)} ${D.p<0.05?'< .05 → H₀ 기각':'≥ .05 → H₀ 기각 실패'}. d̄ 95% CI [${f2(D.ci[0])}, ${f2(D.ci[1])}], d_z = ${f2(D.dz)}.`,
  ne:()=>D.p<0.05?`뒤집어서 쌓은 더미 위에 곡선을 겹치면 거의 같은 모양이에요. 이 곡선으로 정확히 계산한 우연일 확률은 ${spPct(D.p)}예요. 5퍼센트보다 작으니 지하철역 개통 후 상권 매출이 ${up()}다고 판단해요. 다만 그동안 경기 같은 다른 변화가 있었는지도 함께 살펴봐야 해요.`:`뒤집어서 쌓은 더미 위에 곡선을 겹치면 거의 같은 모양이에요. 이 곡선으로 계산한 우연일 확률은 ${spPct(D.p)}예요. 5퍼센트 이상이니 매출이 변했다고 말하기 어려워요.`,
  np:()=>D.p<0.05?`부호 뒤집기 분포는 자유도 ${D.df}인 티 분포와 거의 일치합니다. 정확한 양측 피 값은 ${D.p.toFixed(3)}로 유의수준 0.05보다 작으므로 귀무가설을 기각합니다. 효과크기 디 제트는 ${f2(D.dz)}입니다. 다만 시간 효과와 구분하려면 대조 상권을 둔 설계가 필요합니다.`:`부호 뒤집기 분포는 자유도 ${D.df}인 티 분포와 거의 일치합니다. 정확한 양측 피 값은 ${D.p.toFixed(3)}로 유의수준 0.05 이상이므로 귀무가설을 기각하지 못합니다.`},
];
let starts=[],slots=[],TOTAL=0,time=0;
const narr=k=>mode==='easy'?ST[k].ne():ST[k].np();
const sents=x=>x.split(/(?<=[.?!])\s+/).filter(Boolean);
function cur(t){let k=0;for(let i=0;i<starts.length;i++)if(t>=starts[i])k=i;return k;}
function prog(k,t){return Math.max(0,Math.min(1,(t-starts[k])/ST[k].d));}
function layout(){const r=+document.getElementById('rate').value||1,k=starts.length?cur(time):0,off=starts.length?time-starts[k]:0;
  starts=[];slots=[];let acc=0;ST.forEach((st,i)=>{const sl=Math.max(st.d+0.8,narr(i).length*0.15/r+0.6);starts.push(acc);slots.push(sl);acc+=sl;});TOTAL=acc;
  time=Math.min(starts[k]+Math.min(off,slots[k]),TOTAL);lastK=-1;}
function script(){document.getElementById('scriptBody').innerHTML=ST.map((st,i)=>`<tr><td>${i+1}. ${L(st.e,st.p)}</td><td>${st.scr}</td><td>${narr(i)}</td></tr>`).join('');}
const chipsEl=document.getElementById('chips');
function chips(){chipsEl.innerHTML='';ST.forEach((s,i)=>{const b=document.createElement('button');b.textContent=(i+1)+'. '+L(s.e,s.p);b.onclick=()=>{stopSpeech();time=starts[i];playing=true;if(voiceOn)speakStage(i);syncPlay();};chipsEl.appendChild(b);});lastK=-1;}
// ---------- 칠판 그리기 ----------
const cv=document.getElementById('cv'),ctx=cv.getContext('2d'),bg=document.createElement('canvas');let W=600,H=420,C={};
function readC(){const s=getComputedStyle(document.documentElement);['board','chalk','dim','yel','pink','sky','org'].forEach(k=>C[k]=s.getPropertyValue('--'+k).trim());}
function resize(){W=cv.parentElement.clientWidth;H=Math.round(Math.max(440,Math.min(560,W*0.68)));const r=window.devicePixelRatio||1;
  cv.width=W*r;cv.height=H*r;cv.style.height=H+'px';ctx.setTransform(r,0,0,r,0,0);
  bg.width=W*r;bg.height=H*r;const b=bg.getContext('2d');b.setTransform(r,0,0,r,0,0);b.fillStyle=C.board;b.fillRect(0,0,W,H);
  const rr=rng(99);for(let i=0;i<14;i++){const g=b.createRadialGradient(rr()*W,rr()*H,0,rr()*W,rr()*H,80+rr()*160);g.addColorStop(0,'rgba(255,255,255,.035)');g.addColorStop(1,'rgba(255,255,255,0)');b.fillStyle=g;b.fillRect(0,0,W,H);}
  for(let i=0;i<W*H/90;i++){b.fillStyle=`rgba(255,255,255,${rr()*.05})`;b.fillRect(rr()*W,rr()*H,1,1);}}
const ease=x=>x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2;
const HAND='"Gaegu","Nanum Pen Script",cursive';
function T(s,x,y,col,size,al='left',w=700){ctx.fillStyle=col;ctx.textAlign=al;ctx.textBaseline='middle';ctx.font=`${w} ${size}px ${HAND}`;ctx.fillText(s,x,y);}
function chalkLine(x0,y0,x1,y1,col,w=2.5,a=1){ctx.globalAlpha=a*.9;ctx.strokeStyle=col;ctx.lineWidth=w;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x0,y0);
  const n=Math.max(2,Math.round(Math.hypot(x1-x0,y1-y0)/14));for(let i=1;i<=n;i++){const t=i/n;ctx.lineTo(x0+(x1-x0)*t+(i<n?Math.sin(i*7.3)*.6:0),y0+(y1-y0)*t+(i<n?Math.cos(i*5.1)*.6:0));}ctx.stroke();ctx.globalAlpha=1;}
function arrowHead(x,y,dir,col){ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x-8*dir,y-5);ctx.lineTo(x-8*dir,y+5);ctx.fill();}

function draw(t){
  ctx.drawImage(bg,0,0,W,H);
  const sm=W<520,fs=sm?15:18,pl=20,pr=20,n=P.n,X=v=>pl+(v-D.lo)/(D.hi-D.lo)*(W-pl-pr),XD=v=>W/2+v/D.dm*(W/2-pr-6);
  const yBef=H*0.085,yAft=H*0.175,yL=H*0.22,yTt=H*0.305,yAr=H*0.335,yDd=H*0.385,yDl=H*0.425,yRul=H*0.535,yB=H*0.93,hB=H*0.30;
  const p0=ease(prog(0,t)),p1=prog(1,t),p2=prog(2,t),p3=prog(3,t),p4=prog(4,t),p5=prog(5,t),p6=prog(6,t);
  const flip=p5>0&&p5<0.5,top=p2>0?Math.max(0.22,1-ease(Math.min(1,p2/0.5))*0.78):1;
  // 위: 가격 축과 두 줄
  ctx.globalAlpha=top;chalkLine(pl,yL,W-pr,yL,C.chalk,2,.8*top);
  for(let v=D.lo;v<=D.hi;v+=5){chalkLine(X(v),yL,X(v),yL+5,C.chalk,1.5,.7*top);T(String(v),X(v),yL+15,C.dim,fs-4,'center',400);}
  T(L('백만 원','백만 원/월'),W-pr,yL-9,C.dim,fs-4,'right',400);
  if(p0>0){ctx.globalAlpha=p0*top;T(L('개통 전','전 (측정 1)'),pl,yBef-16,C.sky,fs);T(L('개통 후','후 (측정 2)'),pl,yAft-16,C.org,fs);}
  ctx.globalAlpha=1;
  const r0=sm?4.2:5.2;
  // 짝 선
  const pl1=ease(Math.max(0,(p1-0.55)/0.45));
  for(let i=0;i<n;i++){const q=ease(Math.max(0,Math.min(1,(p1-(i/n)*0.45)/0.25)));if(q<=0)continue;
    const xb=X(D.B[i]),xa=X(D.A[i]);
    if(pl1>0)chalkLine(xb,yBef,xb+(xa-xb)*pl1,yBef+(yAft-yBef)*pl1,D.d[i]>=0?C.chalk:C.pink,1.6,.7*top);
    ctx.globalAlpha=q*.92*top;ctx.fillStyle=C.sky;ctx.beginPath();ctx.arc(xb,yBef,r0,0,7);ctx.fill();ctx.fillStyle=C.org;ctx.beginPath();ctx.arc(xa,yAft,r0,0,7);ctx.fill();ctx.globalAlpha=1;}
  if(pl1>0.8&&p2===0){const xm=X(D.mB),xa=X(D.mA);ctx.globalAlpha=(pl1-.8)*5;T(L('선이 → 로 기울면 매출 증가','기울기 = 변화'),W-pr,yBef-16,C.dim,fs-3,'right',400);ctx.globalAlpha=1;}
  // 차이 축
  if(p2>0){const a=ease(Math.min(1,p2/0.4));chalkLine(pl,yDl,W-pr,yDl,C.chalk,2,.8*a);
    const st=D.dm>10?4:2;for(let v=-Math.floor(D.dm/st)*st;v<=D.dm;v+=st){chalkLine(XD(v),yDl,XD(v),yDl+5,C.chalk,1.5,.7*a);ctx.globalAlpha=a;T(v===0?L('변화 0','0'):(v>0?'+':'')+v,XD(v),yDl+15,v===0?C.chalk:C.dim,fs-4,'center',v===0?700:400);ctx.globalAlpha=1;}
    ctx.setLineDash([4,5]);chalkLine(XD(0),yAr+8,XD(0),yDl,C.chalk,1.5,.6*a);ctx.setLineDash([]);
    ctx.globalAlpha=a;T(L('변화 (후 − 전)','d = 후 − 전'),pl,yTt,C.chalk,fs-1);ctx.globalAlpha=1;}
  // 4 띠 → 괄호
  if(p3>0&&!flip){const a=ease(Math.min(1,p3/0.4)),shr=ease(Math.max(0,(p3-0.5)/0.5)),half=(D.sd+(D.se-D.sd)*shr)*a,x0=XD(D.md-half),x1=XD(D.md+half);
    ctx.globalAlpha=.13;ctx.fillStyle=C.yel;ctx.fillRect(x0,yDd-14,x1-x0,28);ctx.globalAlpha=1;chalkLine(x0,yDd-15,x0,yDd+15,C.yel,2,.8);chalkLine(x1,yDd-15,x1,yDd+15,C.yel,2,.8);
    T(shr<0.5?L('들쭉날쭉 ±','s_d = ±')+f1(D.sd):L('흔들림 ±','SE = ±')+f2(D.se),W-pr,yTt,C.yel,fs-3,'right',400);}
  // 3 선 → 차이 점 (+ 6 뒤집기)
  if(p2>0){const m=ease(Math.min(1,p2/0.6));
    for(let i=0;i<n;i++){const jy=((i*7)%5-2)*3.5;let tx=XD(D.d[i]);
      if(p5>0&&p5<0.55){const seg=Math.min(3,p5/0.45*3),j=Math.min(2,Math.floor(seg)),lc=ease(Math.min(1,(seg-j)*2));
        const sFrom=j===0?1:D.flips[j-1][i],sTo=D.flips[j][i];let s=sFrom+(sTo-sFrom)*lc;if(p5>=0.45)s=D.flips[2][i]+(1-D.flips[2][i])*ease(Math.min(1,(p5-0.45)/0.1));tx=XD(D.d[i]*s);}
      if(m<1){const xb=X(D.B[i]),xa=X(D.A[i]),ax=xb+(tx-xb)*m,ay=yBef+(yDd+jy-yBef)*m,bx=xa+(tx-xa)*m,by=yAft+(yDd+jy-yAft)*m;chalkLine(ax,ay,bx,by,C.chalk,1.6,.8);}
      ctx.globalAlpha=.92*Math.max(0.3,m);ctx.fillStyle=flip?C.chalk:(D.d[i]>=0?C.chalk:C.pink);ctx.beginPath();ctx.arc(tx,yDd+jy,r0,0,7);ctx.fill();ctx.globalAlpha=1;}
    // 평균 변화 화살표
    const q=ease(Math.max(0,(p2-0.6)/0.4));
    if(q>0&&!flip){const x0=XD(0),xm=XD(D.md),xe=x0+(xm-x0)*q,dir=Math.sign(D.md)||1,ya=yAr;
      chalkLine(xm,yDd-18,xm,yDd+18,C.yel,3.5,q);chalkLine(x0,ya,xe,ya,C.pink,3);if(Math.abs(xe-x0)>8)arrowHead(xe,ya,dir,C.pink);
      if(q>.8){const lab=L('평균 변화 ','d̄ = ')+(D.md>=0?'+':'')+f1(D.md),xr=Math.max(x0,xm)+10;xr<W*0.72?T(lab,xr,ya,C.pink,fs-1,'left'):T(lab,Math.min(x0,xm)-10,ya,C.pink,fs-1,'right');}}}
  // 5 눈금자
  if(p4>0){const a=ease(Math.min(1,p4/0.4)),x0=W/2,u=(W-pl-pr)/14;ctx.globalAlpha=a;chalkLine(pl,yRul,W-pr,yRul,C.dim,1.5,a);
    for(let k=-7;k<=7;k++){const x=x0+k*u;chalkLine(x,yRul-6,x,yRul+6,C.dim,1.5,a);if(Math.abs(k)<=6&&(!sm||k%2===0))T(k===0?L('변화 0','0'):String(k),x,yRul+18,C.dim,fs-4,'center',400);}
    T(L('1칸 = '+f2(D.se)+'백만 원','1 SE = '+f2(D.se)),pl,yRul-16,C.dim,fs-3,'left',400);ctx.globalAlpha=1;
    const q=ease(Math.max(0,(p4-0.4)/0.6)),tv=Math.max(-6.8,Math.min(6.8,D.t)),xt=x0+tv*u*q;
    if(q>0){chalkLine(x0,yRul,xt,yRul,C.yel,4);ctx.fillStyle=C.yel;ctx.beginPath();ctx.arc(xt,yRul,6,0,7);ctx.fill();
      T(L(f2(Math.abs(D.t*q))+'칸 = t','t = '+f2(D.t*q)),xt,yRul-18,C.yel,fs+2,xt>W*0.78?'right':(xt<W*0.22?'left':'center'));}}
  // 6 점수 더미
  if(p5>0.4){const pp=(p5-0.4)/0.6,tl=-5,th=5,X2=v=>pl+(v-tl)/(th-tl)*(W-pl-pr),bwPx=X2(BW)-X2(0),rd=Math.max(1.6,Math.min(bwPx/2-0.6,hB/(D.maxC*2)));
    chalkLine(pl,yB,W-pr,yB,C.chalk,2,.8);for(let v=-4;v<=4;v+=1)T(String(v),X2(v),yB+14,C.dim,fs-4,'center',400);
    const at=Math.abs(D.t);
    D.pile.forEach((o,i)=>{const q=Math.max(0,Math.min(1,(pp*1.25-i/SIMS*0.9)/0.12));if(q<=0)return;const far=Math.abs(o.v)>=at;
      const y=yB-rd-o.h*rd*2,yy=(yB-hB)+(y-(yB-hB))*ease(q);ctx.globalAlpha=.9;ctx.fillStyle=far?C.pink:C.chalk;ctx.beginPath();ctx.arc(X2(o.b*BW),yy,rd,0,7);ctx.fill();ctx.globalAlpha=1;});
    const xt=X2(Math.max(-4.9,Math.min(4.9,D.t)));chalkLine(xt,yB,xt,yB-hB*0.85,C.yel,3);T(L('우리 ','t = ')+f2(D.t),xt,yB-hB*0.85-12,C.yel,fs,xt>W*0.8?'right':'center');
    if(at<5){const xo=X2(-Math.sign(D.t||1)*at);ctx.setLineDash([5,5]);chalkLine(xo,yB,xo,yB-hB*0.5,C.yel,1.5,.7);ctx.setLineDash([]);}}
  // 7 곡선 + 도장
  if(p6>0){const tl=-5,th=5,X2=v=>pl+(v-tl)/(th-tl)*(W-pl-pr),bwPx=X2(BW)-X2(0),rd=Math.max(1.6,Math.min(bwPx/2-0.6,hB/(D.maxC*2))),q=Math.min(1,p6/0.5),xe=tl+(th-tl)*q;
    ctx.globalAlpha=.95;ctx.strokeStyle=C.sky;ctx.lineWidth=3;ctx.beginPath();for(let v=tl;v<=xe;v+=0.05){const y=yB-SIMS*BW*tpdf(v,D.df)*2*rd;v===tl?ctx.moveTo(X2(v),y):ctx.lineTo(X2(v),y);}ctx.stroke();ctx.globalAlpha=1;
    if(p6>0.5){const a=ease((p6-.5)*2),sig=D.p<0.05,col=sig?C.yel:C.dim,s=sig?L(D.md>=0?'늘었다!':'줄었다!','H₀ 기각'):L('변했다고 말하기 어려움','기각 실패'),sub=L('우연일 확률 ','p = ')+(mode==='easy'?pct(D.p):fp(D.p));
      ctx.font=`700 ${fs+4}px ${HAND}`;const w=Math.max(ctx.measureText(s).width,84)+24;ctx.save();ctx.translate(pl+w/2+4,yB-hB*0.68);ctx.rotate(-0.1);ctx.globalAlpha=a;ctx.strokeStyle=col;ctx.lineWidth=3;
      ctx.strokeRect(-w/2,-30,w,58);T(s,0,-10,col,fs+4,'center');T(sub,0,14,col,fs-2,'center',400);ctx.restore();ctx.globalAlpha=1;}}
}

// ---------- 패널 ----------
const $=id=>document.getElementById(id),setT=(id,v)=>$(id).textContent=v;
function panels(){if(!D)return;
  setT('r_t',f2(D.t));setT('r_df',D.df);setT('r_p',fp(D.p));setT('r_md',f2(D.md));setT('r_se',f2(D.se));setT('r_ci',`[${f2(D.ci[0])}, ${f2(D.ci[1])}]`);setT('r_d',f2(D.dz));
  $('report').textContent=`보고 예: 지하철역 개통 후 점포당 월평균 매출(M = ${f2(D.mA)})은 개통 전(M = ${f2(D.mB)})에 비해 ${D.p<0.05?'유의하게 '+(D.md>=0?'증가':'감소')+'하였다':'유의한 변화가 없었다'}, t(${D.df}) = ${f2(D.t)}, p = ${fp(D.p)}, 평균 차이 ${f2(D.md)}, 95% CI [${f2(D.ci[0])}, ${f2(D.ci[1])}], d_z = ${f2(D.dz)}. (JAMOVI에서 전 − 후로 계산하면 t와 평균 차이의 부호가 반대)`;
  setT('vM',P.m.toFixed(1));setT('vS',P.s.toFixed(1));setT('vN',P.n);
  setT('lD',(D.md>=0?'+':'')+f1(D.md));setT('lSe',f2(D.se));setT('lT',f2(D.t));setT('lP',mode==='easy'?pct(D.p):fp(D.p));
  const sig=D.p<0.05,v=$('verdict');v.style.color=sig?'var(--yel)':'var(--dim)';
  v.textContent=sig?L(`우연일 확률 < 5% → 매출이 ${D.md>=0?'늘었다':'줄었다'}!`,`p < .05 → H₀ 기각, t(${D.df}) = ${f2(D.t)}`):L('우연일 확률 ≥ 5% → 변했다고 말하기 어려워요',`p ≥ .05 → H₀ 기각 실패, t(${D.df}) = ${f2(D.t)}`);lastK=-1;}
[['sM','m'],['sS','s'],['sN','n']].forEach(([id,k])=>{$(id).oninput=()=>{P[k]=+$(id).value;build();};});
$('resample').onclick=()=>{seed++;build();};

// ---------- 재생·음성 ----------
let playing=true,speed=1,last=performance.now(),lastK=-1;
const playBtn=$('play'),seek=$('seek'),cap=$('cap'),subs=$('subs'),synth=window.speechSynthesis,vBtn=$('vBtn'),vSel=$('vSel'),vNote=$('vNote'),rateEl=$('rate');
let voiceOn=false,speaking=false,spokenStage=-1,tok=0,voices=[];
function syncPlay(){playBtn.textContent=playing?'일시정지':'재생';}
function loadVoices(){if(!synth)return;voices=synth.getVoices().filter(v=>/^ko/i.test(v.lang));
  vSel.innerHTML=voices.length?voices.map((v,i)=>`<option value="${i}">${v.name.replace(/^(Microsoft|Google)\s*/,'')}</option>`).join(''):'<option>한국어 음성 없음</option>';
  const b=voices.findIndex(v=>/Natural|Online|Google/i.test(v.name));if(b>=0)vSel.value=b;
  vNote.textContent=voices.length?'Edge의 “SunHi/InJoon (Natural)” 목소리가 가장 자연스럽습니다.':'이 브라우저에 한국어 음성이 없습니다. 내려받은 파일을 Edge나 Chrome에서 열어 주세요.';}
function stopSpeech(){tok++;speaking=false;spokenStage=-1;try{synth&&synth.cancel();}catch(e){}}
function speakStage(k){if(!synth||!voiceOn)return;stopSpeech();spokenStage=k;const my=tok,ss=sents(narr(k));let i=0;speaking=true;
  const next=()=>{if(my!==tok)return;if(i>=ss.length){speaking=false;return;}const u=new SpeechSynthesisUtterance(ss[i]);u.lang='ko-KR';const v=voices[+vSel.value];if(v)u.voice=v;u.rate=+rateEl.value;
    subs.textContent=ss[i];u.onend=u.onerror=()=>{if(my!==tok)return;i++;next();};synth.speak(u);};next();}
if(synth){loadVoices();synth.onvoiceschanged=loadVoices;}else{vBtn.disabled=true;vSel.hidden=true;vNote.textContent='이 브라우저는 음성 읽기를 지원하지 않습니다.';}
vBtn.onclick=()=>{voiceOn=!voiceOn;vBtn.textContent=voiceOn?'음성 끄기':'음성 켜기';vBtn.classList.toggle('on',voiceOn);if(!voiceOn)stopSpeech();else if(playing)speakStage(cur(time));};
vSel.onchange=()=>{if(voiceOn&&playing)speakStage(cur(time));};
rateEl.onchange=()=>{stopSpeech();layout();};
playBtn.onclick=()=>{if(!playing&&time>=TOTAL)time=0;playing=!playing;if(!playing)stopSpeech();else if(voiceOn)speakStage(cur(time));syncPlay();};
$('restart').onclick=()=>{stopSpeech();time=0;playing=true;if(voiceOn)speakStage(0);syncPlay();};
$('speed').onchange=e=>speed=+e.target.value;
seek.oninput=()=>{stopSpeech();time=seek.value/1000*TOTAL;playing=false;syncPlay();};
$('fs').onclick=()=>{try{(document.fullscreenElement?document.exitFullscreen():$('board').requestFullscreen()).catch(()=>{});}catch(e){}};
$('copyScript').onclick=()=>{const txt=ST.map((st,i)=>`장면 ${i+1}. ${L(st.e,st.p)}\n[화면] ${st.scr.replace('15',P.n)}\n[내레이션] ${narr(i)}`).join('\n\n'),b=$('copyScript');
  try{navigator.clipboard.writeText(txt).then(()=>{b.textContent='복사됨';setTimeout(()=>b.textContent='대본 복사',1500);},()=>{const r=document.createRange();r.selectNode($('scriptBody'));getSelection().removeAllRanges();getSelection().addRange(r);});}catch(e){}};
function loop(now){const dt=Math.min(0.1,(now-last)/1000);last=now;
  if(playing){let nt=time+dt*speed;const k0=cur(time),end=starts[k0]+slots[k0];if(voiceOn&&speaking&&nt>=end-0.02)nt=Math.max(time,end-0.02);
    time=nt;if(time>=TOTAL){time=TOTAL;playing=false;syncPlay();}}
  seek.value=Math.round(time/TOTAL*1000);
  const k=cur(time);if(voiceOn&&playing&&spokenStage!==k)speakStage(k);
  if(!voiceOn||!speaking){const ss=sents(narr(k)),tot=ss.join('').length,f=(time-starts[k])/slots[k]*tot;let a=0,j=0;for(;j<ss.length-1;j++){a+=ss[j].length;if(a>f)break;}if(subs.textContent!==ss[j])subs.textContent=ss[j];}
  if(k!==lastK){lastK=k;cap.innerHTML=`<strong>장면 ${k+1} · ${L(ST[k].e,ST[k].p)}</strong>`+(mode==='easy'?ST[k].ce():ST[k].cp());[...chipsEl.children].forEach((b,i)=>b.classList.toggle('on',i===k));}
  draw(time);requestAnimationFrame(loop);}
window.addEventListener('resize',resize);
document.documentElement.dataset.m='easy';
readC();resize();build();layout();script();chips();
if(matchMedia('(prefers-reduced-motion: reduce)').matches){time=TOTAL;playing=false;}
syncPlay();requestAnimationFrame(loop);
})();
</script>

