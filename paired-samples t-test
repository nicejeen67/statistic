<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">H
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>html{background:#1a1f1d;color-scheme:dark}body{margin:0;font-size:14px}img{max-width:100%}[hidden]{display:none!important}*,*::before,*::after{box-sizing:border-box}</style>
<title>대응표본 t검정 칠판 수업</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Gowun+Dodum&display=swap">
<style>
/* Layout: 어두운 교실 벽 위에 나무 테 칠판(캔버스) → 분필 받침(조작) → 노란 포스트잇(단계 설명) → 카드들. 한 가지 테마(칠판)로 고정 */
:root{
  --wall:#1a1f1d; --board:#203b33; --frame:#6e4b2f; --tray:#4f3622;
  --chalk:#efebe0; --dim:#a7b5ad; --yel:#f2d06b; --pink:#f08a9a; --sky:#8ec5e8; --org:#f2a65a;
  --note:#fff1a8; --noteInk:#3a321a; --card:#232a27; --line:#3a4641;
  --hand:"Gaegu","Nanum Pen Script",cursive; --body:"Gowun Dodum","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  color-scheme:dark;
}
body{background:var(--wall);color:var(--chalk);font-family:var(--body);font-size:15px;line-height:1.65}
.wrap{max-width:920px;margin:0 auto;padding-block:20px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:18px}
h1{font-family:var(--hand);font-weight:700;font-size:2.3rem;line-height:1.1;margin:0;text-wrap:balance}
h1 small{display:block;font-size:1.1rem;color:var(--dim);font-weight:400;margin-top:6px}
h2{font-family:var(--hand);font-weight:700;font-size:1.6rem;margin:0 0 8px;color:var(--yel)}
.top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px}
.seg{display:inline-flex;border:2px solid var(--dim);border-radius:10px;overflow:hidden}
.seg button{border:0;background:transparent;color:var(--dim);font-family:var(--hand);font-size:1.15rem;font-weight:700;padding:4px 14px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--chalk);color:var(--board)}
.board{border:12px solid var(--frame);border-bottom-width:0;border-radius:8px 8px 0 0;background:var(--board);box-shadow:inset 0 0 40px rgba(0,0,0,.45)}
canvas{display:block;width:100%}
.subs{font-family:var(--hand);font-size:1.3rem;color:var(--chalk);text-align:center;padding:6px 16px 12px;min-height:3.4em;display:flex;align-items:center;justify-content:center;line-height:1.35;text-wrap:balance;border-top:1px dashed rgba(239,235,224,.25)}
.tray{background:var(--tray);border-radius:0 0 8px 8px;padding:10px 12px;display:flex;flex-direction:column;gap:8px;margin-top:-18px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.btn{background:var(--chalk);color:var(--board);border:0;border-radius:6px;font-family:var(--hand);font-weight:700;font-size:1.1rem;padding:3px 12px;cursor:pointer;box-shadow:0 2px 0 rgba(0,0,0,.35)}
.btn.ghost{background:transparent;color:var(--chalk);border:1.5px solid var(--dim);box-shadow:none}
.btn.on{background:var(--yel)}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--yel);outline-offset:2px}
select{font-family:var(--body);font-size:14px;padding:4px 6px;border-radius:6px;border:1px solid var(--dim);background:var(--wall);color:var(--chalk);max-width:180px}
#seek{flex:1 1 160px;min-width:0;accent-color:var(--yel)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips button{background:transparent;border:1.5px dashed var(--dim);color:var(--dim);border-radius:6px;font-family:var(--hand);font-size:1.05rem;padding:0 9px;cursor:pointer}
.chips button.on{border-style:solid;border-color:var(--yel);color:var(--yel)}
#vNote{font-size:12px;color:var(--dim);flex-basis:100%}
.note{background:var(--note);color:var(--noteInk);padding:16px 18px;transform:rotate(-.6deg);box-shadow:0 6px 14px rgba(0,0,0,.4);font-size:15.5px;min-height:6em}
.note strong{font-family:var(--hand);font-size:1.35rem;display:block;line-height:1.2;margin-bottom:4px}
.note b{background:linear-gradient(transparent 60%,#ffd34d 60%)}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px}
.tbl{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:14px;min-width:600px}
th,td{padding:7px 10px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
th:first-child,td:first-child{text-align:left}
thead th{color:var(--dim);font-weight:400;border-bottom:2px solid var(--chalk)}
.num{font-variant-numeric:tabular-nums;font-family:ui-monospace,Consolas,monospace}
